{
  "$defs": {
    "AudioRemakeSelection": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Episode Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "line_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        }
      },
      "required": [
        "episode_id",
        "scene_id",
        "line_id"
      ],
      "title": "AudioRemakeSelection",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_provider_calls": {
          "default": 80,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Provider Calls",
          "type": "integer"
        },
        "max_elapsed_seconds": {
          "default": 1800,
          "maximum": 14400,
          "minimum": 10,
          "title": "Max Elapsed Seconds",
          "type": "integer"
        },
        "max_repairs_per_stage": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Repairs Per Stage",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "regenerate": {
      "items": {
        "$ref": "#/$defs/AudioRemakeSelection"
      },
      "maxItems": 1000,
      "title": "Regenerate",
      "type": "array"
    },
    "voices": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voices"
    },
    "outputs": {
      "items": {
        "enum": [
          "audio",
          "visual"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key"
  ],
  "title": "RemakeAudioRequest",
  "type": "object"
}
