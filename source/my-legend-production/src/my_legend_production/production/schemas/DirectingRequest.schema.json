{
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "catalog_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "bindings": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 3,
      "minProperties": 1,
      "title": "Bindings",
      "type": "object"
    },
    "initial_outfits": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 3,
      "minProperties": 1,
      "title": "Initial Outfits",
      "type": "object"
    },
    "casting_confirmed": {
      "const": true,
      "title": "Casting Confirmed",
      "type": "boolean"
    },
    "parent_job_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Job Id"
    }
  },
  "required": [
    "idempotency_key",
    "catalog_sha256",
    "bindings",
    "initial_outfits",
    "casting_confirmed"
  ],
  "title": "DirectingRequest",
  "type": "object"
}
