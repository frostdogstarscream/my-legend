{
  "$defs": {
    "AudioEventRef": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Episode Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "line_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "scene_id",
        "line_id"
      ],
      "title": "AudioEventRef",
      "type": "object"
    },
    "CompiledOperation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Operation Id",
          "type": "string"
        },
        "cue_text": {
          "minLength": 1,
          "title": "Cue Text",
          "type": "string"
        },
        "mode": {
          "enum": [
            "speech",
            "one_shot",
            "background",
            "action_note",
            "stop_sound",
            "continue_background",
            "change_background"
          ],
          "title": "Mode",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "source_audio_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Audio Sha256"
        },
        "processing": {
          "anyOf": [
            {
              "enum": [
                "unchanged",
                "looped_background",
                "cropped_background",
                "faded_background",
                "looped_faded_background",
                "cropped_faded_background",
                "automated_background"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processing"
        },
        "parent_audio_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Audio Sha256"
        },
        "target_operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Operation Id"
        },
        "transition_end_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition End Frame"
        },
        "from_gain_db": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Gain Db"
        },
        "to_gain_db": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Gain Db"
        }
      },
      "required": [
        "operation_id",
        "cue_text",
        "mode",
        "start_frame",
        "end_frame"
      ],
      "title": "CompiledOperation",
      "type": "object"
    },
    "CompoundTimelineSource": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "sound_intent": {
                  "enum": [
                    "control_only",
                    "omitted_for_delivery"
                  ]
                }
              },
              "required": [
                "sound_intent"
              ]
            },
            "properties": {
              "kind": {
                "const": "dialogue"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "speech"
                      ]
                    }
                  }
                },
                "maxItems": 1,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "sound_intent": {
                  "enum": [
                    "control_only",
                    "omitted_for_delivery"
                  ]
                }
              },
              "required": [
                "sound_intent"
              ]
            },
            "properties": {
              "kind": {
                "const": "narration"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "speech"
                      ]
                    }
                  }
                },
                "maxItems": 1,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "sound_intent": {
                  "enum": [
                    "control_only",
                    "omitted_for_delivery"
                  ]
                }
              },
              "required": [
                "sound_intent"
              ]
            },
            "properties": {
              "kind": {
                "const": "sfx"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "one_shot",
                        "background",
                        "continue_background",
                        "change_background",
                        "stop_sound"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "sound_intent": {
                  "enum": [
                    "control_only",
                    "omitted_for_delivery"
                  ]
                }
              },
              "required": [
                "sound_intent"
              ]
            },
            "properties": {
              "kind": {
                "const": "music"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "one_shot",
                        "background",
                        "continue_background",
                        "change_background",
                        "stop_sound"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "sound_intent": {
                  "enum": [
                    "control_only",
                    "omitted_for_delivery"
                  ]
                }
              },
              "required": [
                "sound_intent"
              ]
            },
            "properties": {
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "operations": {
                "items": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "action_note",
                        "stop_sound",
                        "continue_background",
                        "change_background"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/AudioEventRef"
        },
        "kind": {
          "enum": [
            "dialogue",
            "narration",
            "sfx",
            "music",
            "action"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "identity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        },
        "sound_intent": {
          "anyOf": [
            {
              "enum": [
                "control_only",
                "omitted_for_delivery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sound Intent"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/CompiledOperation"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "source",
        "kind",
        "text",
        "operations"
      ],
      "title": "CompoundTimelineSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "measured_timeline/2.0",
      "default": "measured_timeline/2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_version_id": {
      "minLength": 1,
      "title": "Source Version Id",
      "type": "string"
    },
    "arrangement_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Arrangement Sha256",
      "type": "string"
    },
    "sample_rate": {
      "const": 48000,
      "default": 48000,
      "title": "Sample Rate",
      "type": "integer"
    },
    "channels": {
      "const": 1,
      "default": 1,
      "title": "Channels",
      "type": "integer"
    },
    "total_frames": {
      "minimum": 1,
      "title": "Total Frames",
      "type": "integer"
    },
    "audio_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/CompoundTimelineSource"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "word_alignment": {
      "const": "not_available",
      "default": "not_available",
      "title": "Word Alignment",
      "type": "string"
    }
  },
  "required": [
    "source_version_id",
    "arrangement_sha256",
    "total_frames",
    "audio_sha256",
    "events"
  ],
  "title": "CompoundTimeline",
  "type": "object"
}
