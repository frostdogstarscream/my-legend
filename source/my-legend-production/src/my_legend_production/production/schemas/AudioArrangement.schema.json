{
  "$defs": {
    "AudioEventRef": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Episode Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "line_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "scene_id",
        "line_id"
      ],
      "title": "AudioEventRef",
      "type": "object"
    },
    "SoundAnchor": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioEventRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "point": {
          "default": "start",
          "enum": [
            "start",
            "end"
          ],
          "title": "Point",
          "type": "string"
        },
        "offset_ms": {
          "default": 0,
          "maximum": 60000,
          "minimum": -60000,
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "required": [
        "event"
      ],
      "title": "SoundAnchor",
      "type": "object"
    },
    "SoundDecision": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dialogue"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "speech"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "narration"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "speech"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sfx"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "one_shot",
                  "background",
                  "continue_background",
                  "change_background",
                  "stop_sound"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "music"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "one_shot",
                  "background",
                  "continue_background",
                  "change_background",
                  "stop_sound"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "action_note",
                  "stop_sound",
                  "continue_background",
                  "change_background"
                ]
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "end": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "background"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "end": {
                "type": "object"
              }
            },
            "required": [
              "end"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "stop_target": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "stop_sound"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "stop_target": {
                "type": "object"
              }
            },
            "required": [
              "stop_target"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "control_target": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "continue_background",
                  "change_background"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "control_target": {
                "type": "object"
              }
            },
            "required": [
              "control_target"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "transition_end": {
                "type": "null"
              },
              "target_gain_db": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "change_background"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "transition_end": {
                "type": "object"
              },
              "target_gain_db": {
                "type": "number"
              }
            },
            "required": [
              "transition_end",
              "target_gain_db"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "not": {
                  "const": "background"
                }
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "fade_out_ms": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "action_note",
                  "stop_sound",
                  "continue_background",
                  "change_background"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "gain_db": {
                "const": 0
              }
            }
          }
        }
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/AudioEventRef"
        },
        "kind": {
          "enum": [
            "dialogue",
            "narration",
            "sfx",
            "music",
            "action"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "identity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        },
        "mode": {
          "enum": [
            "speech",
            "one_shot",
            "background",
            "action_note",
            "stop_sound",
            "continue_background",
            "change_background"
          ],
          "title": "Mode",
          "type": "string"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/SoundAnchor"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioEventRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gain_db": {
          "default": 0.0,
          "maximum": 12,
          "minimum": -60,
          "title": "Gain Db",
          "type": "number"
        },
        "fade_out_ms": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Fade Out Ms",
          "type": "integer"
        },
        "control_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioEventRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transition_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoundAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_gain_db": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Gain Db"
        }
      },
      "required": [
        "source",
        "kind",
        "text",
        "mode",
        "evidence_quote",
        "reason",
        "start"
      ],
      "title": "SoundDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "audio_arrangement/1.0",
      "enum": [
        "audio_arrangement/1.0",
        "audio_arrangement/1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "source_version_id": {
      "minLength": 1,
      "title": "Source Version Id",
      "type": "string"
    },
    "delivery_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Delivery Sha256",
      "type": "string"
    },
    "sample_rate": {
      "const": 48000,
      "default": 48000,
      "title": "Sample Rate",
      "type": "integer"
    },
    "channels": {
      "const": 1,
      "default": 1,
      "title": "Channels",
      "type": "integer"
    },
    "duck_gain_db": {
      "default": -9.0,
      "maximum": 0,
      "minimum": -30,
      "title": "Duck Gain Db",
      "type": "number"
    },
    "duck_attack_ms": {
      "default": 30,
      "maximum": 1000,
      "minimum": 0,
      "title": "Duck Attack Ms",
      "type": "integer"
    },
    "duck_release_ms": {
      "default": 100,
      "maximum": 2000,
      "minimum": 0,
      "title": "Duck Release Ms",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/SoundDecision"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "source_version_id",
    "delivery_sha256",
    "events"
  ],
  "title": "AudioArrangement",
  "type": "object"
}
