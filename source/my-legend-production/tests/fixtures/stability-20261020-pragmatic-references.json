{
  "slots": [
    {
      "slot_id": "line_0001",
      "speech_id": "speech_0001",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l1"
      },
      "kind": "sfx",
      "text": "风雨声沉闷，偶尔有雨点打在窗户上的声音。突然，门外传来一阵断续的、不规律的敲击声，像是木头撞击门框，间隔时长时短。",
      "identity_id": null
    },
    {
      "slot_id": "line_0002",
      "speech_id": "speech_0002",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l2"
      },
      "kind": "action",
      "text": "墨羽警觉地站起身，椅子发出轻微的挪动声。",
      "identity_id": null
    },
    {
      "slot_id": "line_0003",
      "speech_id": "speech_0003",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l3"
      },
      "kind": "dialogue",
      "text": "有人在敲门？",
      "identity_id": "legend-moyu"
    },
    {
      "slot_id": "line_0004",
      "speech_id": "speech_0004",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l4"
      },
      "kind": "action",
      "text": "灵墨侧耳倾听，没有立刻回答。",
      "identity_id": null
    },
    {
      "slot_id": "line_0005",
      "speech_id": "speech_0005",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l5"
      },
      "kind": "sfx",
      "text": "敲击声再次响起，节奏依然混乱。",
      "identity_id": null
    },
    {
      "slot_id": "line_0006",
      "speech_id": "speech_0006",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l6"
      },
      "kind": "dialogue",
      "text": "你听，是不是不太规律？不像正常的敲门。",
      "identity_id": "legend-lingmo"
    },
    {
      "slot_id": "line_0007",
      "speech_id": "speech_0007",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l7"
      },
      "kind": "dialogue",
      "text": "我出去看看。",
      "identity_id": "legend-moyu"
    },
    {
      "slot_id": "line_0008",
      "speech_id": "speech_0008",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l8"
      },
      "kind": "dialogue",
      "text": "等一下，一起去。",
      "identity_id": "legend-lingmo"
    },
    {
      "slot_id": "line_0009",
      "speech_id": "speech_0009",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l9"
      },
      "kind": "sfx",
      "text": "提灯被拿起的轻微金属碰撞声。",
      "identity_id": null
    },
    {
      "slot_id": "line_0010",
      "speech_id": "speech_0010",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l10"
      },
      "kind": "narration",
      "text": "墨羽提起桌上的灯，两人走向门口。",
      "identity_id": "narrator"
    },
    {
      "slot_id": "line_0011",
      "speech_id": "speech_0011",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene1",
        "line_id": "ep1-s1-l11"
      },
      "kind": "sfx",
      "text": "门闩滑动声，随后是门被拉开的吱呀声。",
      "identity_id": null
    },
    {
      "slot_id": "line_0012",
      "speech_id": "speech_0012",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l1"
      },
      "kind": "sfx",
      "text": "风雨声瞬间由沉闷变得开阔而猛烈，风声呼啸，雨声清晰。",
      "identity_id": null
    },
    {
      "slot_id": "line_0013",
      "speech_id": "speech_0013",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l2"
      },
      "kind": "narration",
      "text": "墨羽举起灯照亮前方，但门外空无一人。",
      "identity_id": "narrator"
    },
    {
      "slot_id": "line_0014",
      "speech_id": "speech_0014",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l3"
      },
      "kind": "sfx",
      "text": "敲击声再次响起，这次声音的方向感更明确，来自门框侧面。",
      "identity_id": null
    },
    {
      "slot_id": "line_0015",
      "speech_id": "speech_0015",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l4"
      },
      "kind": "action",
      "text": "两人循声望去，灵墨走近门框，伸手按住一块晃动的木牌。",
      "identity_id": null
    },
    {
      "slot_id": "line_0016",
      "speech_id": "speech_0016",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l5"
      },
      "kind": "sfx",
      "text": "木板晃动碰墙的声音骤然停止。",
      "identity_id": null
    },
    {
      "slot_id": "line_0017",
      "speech_id": "speech_0017",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l6"
      },
      "kind": "dialogue",
      "text": "是这块牌子松了，风一吹就撞在门框上。",
      "identity_id": "legend-lingmo"
    },
    {
      "slot_id": "line_0018",
      "speech_id": "speech_0018",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l7"
      },
      "kind": "dialogue",
      "text": "原来只是它。来，我们把它按回去。",
      "identity_id": "legend-moyu"
    },
    {
      "slot_id": "line_0019",
      "speech_id": "speech_0019",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l8"
      },
      "kind": "sfx",
      "text": "提灯被放在地上的轻响。",
      "identity_id": null
    },
    {
      "slot_id": "line_0020",
      "speech_id": "speech_0020",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l9"
      },
      "kind": "sfx",
      "text": "木头摩擦挤压的声音，最后是一声沉闷的卡榫入位声。",
      "identity_id": null
    },
    {
      "slot_id": "line_0021",
      "speech_id": "speech_0021",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l10"
      },
      "kind": "action",
      "text": "墨羽松开手，两人在风雨中静静等待了片刻。",
      "identity_id": null
    },
    {
      "slot_id": "line_0022",
      "speech_id": "speech_0022",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene2",
        "line_id": "ep1-s2-l11"
      },
      "kind": "dialogue",
      "text": "好了，虚惊一场。",
      "identity_id": "legend-lingmo"
    },
    {
      "slot_id": "line_0023",
      "speech_id": "speech_0023",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l1"
      },
      "kind": "sfx",
      "text": "提灯被重新拿起的声音。",
      "identity_id": null
    },
    {
      "slot_id": "line_0024",
      "speech_id": "speech_0024",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l2"
      },
      "kind": "narration",
      "text": "两人转身走回屋内，墨羽关上了门。",
      "identity_id": "narrator"
    },
    {
      "slot_id": "line_0025",
      "speech_id": "speech_0025",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l3"
      },
      "kind": "sfx",
      "text": "关门声，风雨声瞬间被隔绝，重新变得沉闷，室内恢复安静。",
      "identity_id": null
    },
    {
      "slot_id": "line_0026",
      "speech_id": "speech_0026",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l4"
      },
      "kind": "sfx",
      "text": "提灯落桌的轻响。",
      "identity_id": null
    },
    {
      "slot_id": "line_0027",
      "speech_id": "speech_0027",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l5"
      },
      "kind": "action",
      "text": "两人都松了一口气，灵墨看着墨羽，轻轻笑了一声。",
      "identity_id": null
    },
    {
      "slot_id": "line_0028",
      "speech_id": "speech_0028",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l6"
      },
      "kind": "dialogue",
      "text": "还好只是风。",
      "identity_id": "legend-moyu"
    },
    {
      "slot_id": "line_0029",
      "speech_id": "speech_0029",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l7"
      },
      "kind": "narration",
      "text": "两人在灯光下安静地坐下，屋外的风雨声渐渐减弱。",
      "identity_id": "narrator"
    },
    {
      "slot_id": "line_0030",
      "speech_id": "speech_0030",
      "source": {
        "episode_id": "ep-1-c9562cd7",
        "scene_id": "ep1-scene3",
        "line_id": "ep1-s3-l8"
      },
      "kind": "sfx",
      "text": "屋外风雨声渐弱，转为隐约的白噪音，屋内只剩下安稳的呼吸声和灯火的微响。",
      "identity_id": null
    }
  ],
